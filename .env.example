# Supabase (ambil dari Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://<PROJECT-REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Database lokal via PostgREST (opsional)
VITE_DB_LOCAL_URL=https://db.styna.my.id
VITE_DB_LOCAL_ANON_KEY=

# Audio yt-dlp via Cloudflare Tunnel
VITE_YAPI_URL=https://yapi.styna.my.id

# HANYA untuk serverless / lokal. JANGAN pakai prefix VITE_ dan jangan commit .env asli.
# Dipakai oleh api/auth/* untuk register/login (RLS accounts bersifat read-only untuk anon).
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: rahasia HMAC untuk token sesi (default: SUPABASE_SERVICE_ROLE_KEY)
# AUTH_SECRET=
